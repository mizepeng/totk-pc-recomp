<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded by totk.rc. activeCodePage makes UTF-8 the process code page (Windows 10 1903 and later): the narrow file
     functions (fopen, CreateFileA, GetModuleFileNameA) and getenv then carry UTF-8, the same encoding platform/win32.c
     and fs_host.c convert with, so an install folder or user profile with a non-ASCII name works.
     dpiAwareness PerMonitorV2 (dpiAware true/pm on Windows 10 before 1607): window, monitor and cursor sizes are physical
     pixels and the swapchain matches the screen. A DPI-unaware process gets them divided by the display scale and its
     image stretched back up by Windows, so 4K at 150% presented a 2560x1440 image, blurred. gfx_window.c follows a
     change of the window's DPI (WM_GETDPISCALEDSIZE, WM_DPICHANGED). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <!-- consoleAllocationPolicy detached（Windows 11 24H2 及以后生效，旧系统忽略）：控制台程序 totk.exe 从资源管理器或
           快捷方式启动时不分配控制台窗口；从终端启动时共用终端的控制台，shell 照常等它退出并拿到退出码。旧系统上由
           main.c 关掉系统给它新开的控制台，命令行带 console 参数时保留（platform/win32.c plat_console_drop_own）。
           XML 注释里不能出现两个连续的减号，否则清单解析失败、程序无法启动，所以这里不写参数原文。 -->
      <consoleAllocationPolicy xmlns="http://schemas.microsoft.com/SMI/2024/WindowsSettings">detached</consoleAllocationPolicy>
    </windowsSettings>
  </application>
</assembly>
